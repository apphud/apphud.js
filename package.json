{
  "name": "apphud.js",
  "version": "3.0.0",
  "homepage": "https://apphud.com",
  "description": "Apphud Web-to-Web SDK",
  "type": "module",
  "main": "./dist/v3/apphud.js",
  "module": "./dist/v3/apphud.esm.js",
  "exports": {
    ".": {
      "import": "./dist/v3/apphud.esm.js",
      "default": "./dist/v3/apphud.js"
    },
    "./renderer": {
      "types": "./dist/v3/types/entries/renderer.d.ts",
      "default": "./dist/v3/apphud-renderer.esm.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "renderer": [
        "./dist/v3/types/entries/renderer.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "rollup -c && tsc -p tsconfig.renderer.json && node scripts/check-bundles.mjs",
    "test": "vitest run",
    "lint": "eslint src",
    "docs": "typedoc"
  },
  "keywords": [
    "apphud",
    "web-to-web",
    "web2web"
  ],
  "authors": [
    "Alexander Selivanov"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/apphud/apphud.js"
  },
  "files": [
    "dist/v3/apphud.js",
    "dist/v3/apphud.esm.js",
    "dist/v3/apphud-renderer.esm.js",
    "dist/v3/types"
  ],
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@paddle/paddle-js": "^1.2.1",
    "@rollup/plugin-buble": "^1.0.1",
    "@rollup/plugin-commonjs": "^24.0.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-replace": "^5.0.7",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^11.1.6",
    "@stripe/stripe-js": "^4.5.0",
    "@stripe/stripe-js-dahlia": "npm:@stripe/stripe-js@^9.17.0",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "^22.5.0",
    "@types/ua-parser-js": "^0.7.39",
    "@typescript-eslint/eslint-plugin": "^8.0.1",
    "@typescript-eslint/parser": "^8.0.1",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.3.3",
    "rollup": "^3.9.1",
    "tslib": "^2.6.3",
    "typedoc": "^0.28.x",
    "typedoc-plugin-markdown": "^4.2.7",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.1",
    "ua-parser-js": "^1.0.38",
    "vitest": "^3.2.7"
  }
}
